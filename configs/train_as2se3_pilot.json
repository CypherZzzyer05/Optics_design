{
  "dataset": "../data/as2se3_au_pilot/dataset.npz",
  "output_dir": "../runs/as2se3_au_pilot",
  "allow_validation_data": true,
  "seed": 42,
  "device": "auto",
  "epochs": 2,
  "batch_size": 2,
  "learning_rate": 0.0003,
  "weight_decay": 0.001,
  "gradient_clip_norm": 1.0,
  "early_stopping_patience": 2,
  "min_delta": 1e-05,
  "lr_patience": 10,
  "lr_factor": 0.5,
  "min_learning_rate": 1e-06,
  "mixed_precision": true,
  "model": {
    "spectrum_points": 1000,
    "patch_count": 100,
    "embedding_dim": 128,
    "attention_heads": 10,
    "head_dim": 64,
    "encoder_layers": 10,
    "mlp_dim": 256,
    "dropout": 0.1,
    "geometry_dim": 7,
    "spectral_frontend": "resnet1d",
    "resnet_channels": 32,
    "resnet_blocks": 3,
    "resnet_kernel_size": 7,
    "angle_symmetry": "square_periodic"
  }
}
