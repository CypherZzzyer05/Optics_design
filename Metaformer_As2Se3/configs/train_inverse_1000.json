{
  "dataset": "../examples/au100_metal8_1000/dataset.npz",
  "output_dir": "../runs/inverse_au100_metal8_1000",
  "allow_validation_data": true,
  "seed": 44,
  "device": "cuda",
  "epochs": 100,
  "batch_size": 8,
  "learning_rate": 0.0003,
  "weight_decay": 0.001,
  "gradient_clip_norm": 1.0,
  "early_stopping_patience": 20,
  "min_delta": 1E-05,
  "lr_patience": 10,
  "lr_factor": 0.5,
  "min_learning_rate": 1E-06,
  "mixed_precision": true,
  "optimizer": "adamw",
  "validation_only": false,
  "model": {
    "spectrum_points": 1000,
    "patch_count": 100,
    "embedding_dim": 128,
    "attention_heads": 10,
    "head_dim": 64,
    "encoder_layers": 10,
    "mlp_dim": 256,
    "dropout": 0.1,
    "geometry_dim": 7,
    "spectral_frontend": "linear",
    "angle_symmetry": "square_periodic",
    "activation": "gelu",
    "norm_order": "pre",
    "input_normalization": "train_standard",
    "normalization_floor": 0.02
  }
}
